# Copy to .env and fill in. Nothing here is required to run locally: without AI keys the backend uses the
# deterministic "mock" provider and without Stripe keys a fake payment gateway, so the whole flow works end to end.
# What each value is and where to get it: docs/setup-checklist.md. Leave a line blank to use the default.

# ── Local services ──────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://jmo:jmo@localhost:54329/jmo
API_PORT=8787
ADMIN_API_PORT=8788
PUBLIC_API_URL=http://localhost:8787
ADMIN_ORIGIN=http://localhost:5174
WEB_ORIGIN=http://localhost:5175
# Email address of the first admin (Owner), used when the database is seeded.
ADMIN_OWNER_EMAIL=owner@example.com

# ── AI providers (checklist §1–4) ───────────────────────────────────────────────────────────────
# With OPENAI_API_KEY set before the first seed (or `pnpm db:reset`), every step is routed to OpenAI.
# Keys can also be added later in the admin panel (AI providers & keys), which stores them encrypted.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Paid-tier Gemini only (the free tier's terms forbid personal data such as resumes).
GOOGLE_API_KEY=
# NVIDIA API Catalog trial key: EVAL ONLY with synthetic data (trial terms forbid production and personal data).
NVIDIA_API_KEY=
# Local testing on free NVIDIA trial models: set AI_ROUTING=eval, run `pnpm nvidia:setup`, restart the API,
# and use made-up resumes only (samples/sample-resume.pdf). Refused in production.
AI_ROUTING=
# OpenRouter free (":free") models, same rules as NVIDIA: AI_ROUTING=eval, run `pnpm openrouter:setup`, synthetic data only.
OPENROUTER_API_KEY=

# ── Payments: Stripe (checklist §5) ─────────────────────────────────────────────────────────────
# Leave empty locally to use the fake payment gateway. Test mode: sk_test_… then run `pnpm stripe:setup`.
STRIPE_SECRET_KEY=
# The whsec_… printed by `stripe listen --forward-to localhost:8787/v1/webhooks/stripe` (or a dashboard endpoint).
STRIPE_WEBHOOK_SECRET=

# ── Email: Resend (checklist §6) ────────────────────────────────────────────────────────────────
# Empty = sign-in codes are printed in the API console (development only).
RESEND_API_KEY=
EMAIL_FROM="Job Match Optimizer <onboarding@resend.dev>"

# ── Google sign-in (checklist §6b) ──────────────────────────────────────────────────────────────
# Public OAuth "Web application" client ID; used by the API (to verify tokens), the extension and the website.
# Empty = the "Continue with Google" button is hidden.
GOOGLE_OAUTH_CLIENT_ID=

# ── Front-end builds ────────────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8787
VITE_ADMIN_API_URL=http://localhost:8788
VITE_CHROME_STORE_URL=
# Extension build (empty = local defaults). CONFIG_PUBLIC_KEY_JWK: public half of the config signing key.
EXTENSION_API_URL=
EXTENSION_WEB_URL=
CONFIG_PUBLIC_KEY_JWK=

# ── Secrets generated by us, not by a provider (filled in at deploy time; local dev generates them) ──
# JWT_SECRET: 32+ random characters (production refuses this placeholder). INTERNAL_TOKEN: shared by the API and admin API.
JWT_SECRET=dev-only-change-me-0123456789abcdef0123456789abcdef
INTERNAL_TOKEN=
# Encryption keys, 32+ random characters each and different from JWT_SECRET; required in production (development
# derives them). MAILBOX_KEY: results held ≤ 24 h. CONTENT_ENCRYPTION_KEY: opted-in users' saved job posts/resumes/results.
MAILBOX_KEY=
CONTENT_ENCRYPTION_KEY=
# Key vault (RSA-OAEP-256): pnpm --filter @jmo/vault keygen
VAULT_PUBLIC_KEY_JWK=
VAULT_PRIVATE_KEY_JWK=
# Config signing (Ed25519) for GET /v1/config: pnpm --filter @jmo/config keygen
CONFIG_SIGNING_PRIVATE_KEY_JWK=

# ── Going live (checklist §9–15) ────────────────────────────────────────────────────────────────
# chrome-extension://<id> of the published extension (comma-separated if several).
EXTENSION_ORIGINS=
# Cloudflare Access in front of the admin panel and admin API.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Production without Cloudflare Access (e.g. the admin API on Render): set to true to allow it. Admins are then
# protected by emailed sign-in codes, step-up and the audit log only. Leave unset where Access is configured.
ADMIN_ALLOW_WITHOUT_ACCESS=
ADMIN_DEV_LOGIN=true

# ── Production deploy (pnpm deploy:prod init copies these into .env.production) ─────────────────
# Production Postgres, e.g. a free Neon database (kept apart from the local DATABASE_URL).
PROD_DATABASE_URL=
# Render → Account settings → API keys (the APIs run as Render free web services).
RENDER_API_KEY=
