// Admin API: a Worker in front of one Cloudflare Container (Workers Paid plan). It never receives the vault private
// key or the config-signing key. Deploy with `pnpm deploy:prod`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jmo-admin-api",
  "main": "containers.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "AdminApiContainer",
      "image": "../docker/Dockerfile",
      "image_build_context": "../..",
      "image_vars": { "APP": "admin-api" },
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": { "bindings": [{ "name": "APP", "class_name": "AdminApiContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AdminApiContainer"] }]
}
