// Admin panel: static files on Workers (apps/admin/public/_headers applies). Built and deployed by
// `pnpm deploy:prod`. Put it and the admin API behind Cloudflare Access for real use.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jmo-admin",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": { "directory": "../../apps/admin/dist", "not_found_handling": "single-page-application" }
}
